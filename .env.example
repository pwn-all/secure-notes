# Copy to .env and supply your instance hostname and TLS certificate paths.
PUBLIC_HOST=localhost
HTTP_BIND_ADDR=0.0.0.0:80
HTTPS_BIND_ADDR=0.0.0.0:443
TLS_CERT_PATH=/etc/letsencrypt/live/localhost/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/localhost/privkey.pem

# Generate a unique signing seed with the command in README.md when stable pins
# across restarts are required. Never commit the seed or copy it between servers.
# SIGNING_KEY=

MAX_PLAINTEXT_BYTES=32768
MAX_BLOB_BYTES=49152
MAX_NOTE_STORAGE_BYTES=67108864
MAX_NOTES=50000
MAX_ACTIVE_CHALLENGES=10000
MAX_TRACKING_ENTRIES=100000
MAX_CONCURRENT_API_REQUESTS=64
