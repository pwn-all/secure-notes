# Copy to .env and supply your instance hostname and TLS certificate paths.
PUBLIC_HOST=localhost
HTTP_BIND_ADDR=0.0.0.0:80
HTTPS_BIND_ADDR=0.0.0.0:443
TLS_CERT_PATH=/etc/letsencrypt/live/localhost/fullchain.pem
TLS_KEY_PATH=/etc/letsencrypt/live/localhost/privkey.pem

# Generate a unique signing seed with the command in README.md when stable pins
# across restarts are required. Never commit the seed or copy it between servers.
# SIGNING_KEY=

MAX_PLAINTEXT_BYTES=32768
MAX_BLOB_BYTES=49152
MAX_NOTE_STORAGE_BYTES=67108864
MAX_NOTES=50000
MAX_ACTIVE_CHALLENGES=10000
MAX_TRACKING_ENTRIES=100000
MAX_CONCURRENT_API_REQUESTS=64

# Proof-of-work: Argon2id only (docs/pow-spec.md). There is no other scheme;
# the server refuses to start if POW_ALG is set to anything but argon2id or
# if a POW_BITS* value exceeds 12. Expected client work = rounds * 2^bits
# Argon2id evaluations (~15 ms each in a desktop browser, ~60 ms on a phone).
# POW_BITS_CREATE=4
# POW_BITS_CREATE_MAX=7
# POW_BITS_VIEW=3
# POW_BITS_VIEW_MAX=5
# POW_ROUNDS_CREATE=4
# POW_ROUNDS_VIEW=2
# POW_ARGON2_M_KIB=4096
# POW_ARGON2_T=1
# POW_VERIFY_CONCURRENCY=<cpu count>

# Encrypted file attachments: total bytes per note, 0 disables uploads (max
# 67108864). Files are encrypted in the browser inside the note blob; size the
# note store and container memory for it (README: "File uploads and memory").
MAX_FILE_BYTES=0
# UPLOAD_TIMEOUT_SECS=120

# Signed instance passport in /info (docs/ram-only.md): version, start time,
# SHA-256 of the running binary and RAM-only hardening flags. Set 0 to omit.
PUBLISH_PASSPORT=1
